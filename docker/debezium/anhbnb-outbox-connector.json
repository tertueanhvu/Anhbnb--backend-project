{
  "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
  "tasks.max": "1",
  "database.hostname": "postgres",
  "database.port": "5432",
  "database.user": "hotel_booking_cdc",
  "database.password": "${env:CDC_DB_PASSWORD}",
  "database.dbname": "hotel_booking_dev",
  "topic.prefix": "anhbnb-cdc",
  "plugin.name": "pgoutput",
  "slot.name": "anhbnb_outbox_slot",
  "slot.drop.on.stop": "false",
  "publication.name": "anhbnb_outbox_publication",
  "publication.autocreate.mode": "disabled",
  "table.include.list": "public.outbox_events",
  "snapshot.mode": "initial",
  "tombstones.on.delete": "false",
  "heartbeat.interval.ms": "0",
  "key.converter": "org.apache.kafka.connect.storage.StringConverter",
  "value.converter": "org.apache.kafka.connect.json.JsonConverter",
  "value.converter.schemas.enable": "false",
  "transforms": "outbox",
  "transforms.outbox.type": "io.debezium.transforms.outbox.EventRouter",
  "transforms.outbox.predicate": "isOutbox",
  "predicates": "isOutbox",
  "predicates.isOutbox.type": "org.apache.kafka.connect.transforms.predicates.TopicNameMatches",
  "predicates.isOutbox.pattern": "anhbnb-cdc\\.public\\.outbox_events",
  "transforms.outbox.table.field.event.id": "event_id",
  "transforms.outbox.table.field.event.key": "aggregate_id",
  "transforms.outbox.table.field.event.payload": "payload",
  "transforms.outbox.table.expand.json.payload": "true",
  "transforms.outbox.table.json.payload.null.behavior": "optional_bytes",
  "transforms.outbox.route.by.field": "aggregate_type",
  "transforms.outbox.route.topic.replacement": "anhbnb.${routedByValue}.events.v1",
  "transforms.outbox.table.op.invalid.behavior": "fatal",
  "producer.override.acks": "all",
  "producer.override.enable.idempotence": "true",
  "producer.override.retries": "2147483647",
  "producer.override.max.in.flight.requests.per.connection": "5"
}
