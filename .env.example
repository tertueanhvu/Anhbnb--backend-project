NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://hotel_booking_app:CHANGE_THIS_LOCAL_PASSWORD@localhost:5432/hotel_booking_dev
TEST_DATABASE_URL=postgresql://hotel_booking_app:CHANGE_THIS_LOCAL_PASSWORD@localhost:5432/hotel_booking_test

JWT_SECRET=GENERATE_AT_LEAST_32_RANDOM_BYTES
JWT_EXPIRES_IN=1d
BUSINESS_TIMEZONE=Asia/Ho_Chi_Minh
BOOKING_HOLD_MINUTES=15
RECONCILE_INTERVAL_MS=30000
PAYMENT_RECONCILE_GRACE_MS=60000
BACKGROUND_JOBS_ENABLED=true
AVAILABILITY_WINDOW_DAYS=365
MAX_STAY_NIGHTS=365
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

PAYMENT_PROVIDER_MODE=mock
ZALOPAY_APP_ID=SANDBOX_APP_ID
ZALOPAY_KEY1=SANDBOX_KEY1
ZALOPAY_KEY2=SANDBOX_KEY2
ZALOPAY_CREATE_ORDER_URL=https://sb-openapi.zalopay.vn/v2/create
ZALOPAY_QUERY_ORDER_URL=https://sb-openapi.zalopay.vn/v2/query
ZALOPAY_CALLBACK_URL=https://YOUR_TEMP_TUNNEL/api/v1/payments/zalopay/callback
