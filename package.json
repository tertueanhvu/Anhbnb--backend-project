{
  "name": "comp3080-hotel-booking-api",
  "version": "1.0.0",
  "private": true,
  "description": "Phase 1 hotel booking REST API",
  "main": "src/server.js",
  "scripts": {
    "setup:local": "node scripts/setup-local.js",
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "worker": "node src/worker.js",
    "worker:dev": "node --watch src/worker.js",
    "scheduler": "node src/scheduler.js",
    "scheduler:dev": "node --watch src/scheduler.js",
    "test:consumers": "NODE_ENV=test vitest run --globals tests/integration/consumers.test.js tests/unit/consumer.test.js tests/unit/notification-sender.test.js --no-file-parallelism",
    "events:inspect": "node scripts/events-inspect.js",
    "events:replay": "node scripts/events-replay.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "NODE_ENV=test vitest run --globals tests/unit",
    "test:integration": "NODE_ENV=test vitest run --globals tests/integration --no-file-parallelism",
    "test:redis": "NODE_ENV=test vitest run --globals tests/integration/redis- --no-file-parallelism",
    "test:outbox": "NODE_ENV=test vitest run --globals tests/integration/outbox.test.js --no-file-parallelism",
    "catalog:update": "node scripts/catalog-update.js",
    "catalog:repair": "node scripts/catalog-repair.js",
    "cdc:check": "node scripts/check-cdc.js",
    "test:cdc": "node scripts/test-cdc.js",
    "test:kafka": "NODE_ENV=test KAFKA_INTEGRATION=true vitest run --globals tests/integration/kafka-consumers.test.js --no-file-parallelism",
    "search:init": "node scripts/search-init.js",
    "search:reindex": "node scripts/search-reindex.js",
    "benchmark:cache": "NODE_ENV=test node scripts/benchmark-cache.js",
    "test:reindex": "NODE_ENV=test SEARCH_INTEGRATION=true KAFKA_INTEGRATION=true vitest run --globals tests/integration/search-reindex.test.js --no-file-parallelism",
    "test:compose": "node scripts/test-compose.js",
    "test:search": "NODE_ENV=test SEARCH_INTEGRATION=true vitest run --globals tests/unit/search.test.js tests/integration/search.test.js --no-file-parallelism",
    "test:all": "NODE_ENV=test vitest run --globals --no-file-parallelism",
    "test:newman": "newman run postman/Hotel-Booking.postman_collection.json -e postman/Local.postman_environment.json.example",
    "db:migrate": "knex migrate:latest",
    "db:migrate:test": "NODE_ENV=test knex migrate:latest",
    "db:rollback": "knex migrate:rollback",
    "db:seed": "knex seed:run",
    "db:seed:test": "NODE_ENV=test knex seed:run",
    "db:check": "node scripts/check-database.js",
    "db:reset:test": "node scripts/reset-test-database.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "axios": "^1.12.2",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.11.1",
    "joi": "^18.0.1",
    "jsonwebtoken": "^9.0.2",
    "kafkajs": "^2.2.4",
    "knex": "^3.1.0",
    "pg": "^8.16.3",
    "pino": "^9.9.4",
    "pino-http": "^10.5.0"
  },
  "devDependencies": {
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "newman": "^6.2.1",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4",
    "vitest": "^4.1.11"
  }
}
